{
  "name": "dsh-web-fetch-fakeip",
  "version": "0.2.0",
  "description": "DeepSeek Harness WebFetch with validated fake-IP DNS fallback and local PDF text extraction",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --experimental-test-module-mocks --test test/*.test.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-web": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "ipaddr.js": "^2.5.0",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "^1.0.10",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "author": "charlesjson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charlesjson/dsh-web-fetch-fakeip.git"
  },
  "homepage": "https://github.com/charlesjson/dsh-web-fetch-fakeip#readme",
  "bugs": {
    "url": "https://github.com/charlesjson/dsh-web-fetch-fakeip/issues"
  }
}
